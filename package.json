{
  "name": "basketball",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names servidor,react \"npm:server\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env --use-env-proxy server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test server/index.test.js src/services/basketball.test.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "vite": "^8.0.0"
  }
}
